{
  "name": "@kaoto/kaoto-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "yarn lint:es && yarn lint:style && yarn lint:format",
    "lint-fix": "yarn lint:es --fix && yarn lint:style --fix && yarn lint:format",
    "lint:es": "eslint . --report-unused-disable-directives --max-warnings 0 --cache --cache-location \"node_modules/.cache/eslint/\"",
    "lint:style": "stylelint \"./**/*.scss\" --cache --cache-location \"node_modules/.cache/stylelint/\"",
    "lint:format": "prettier . --write --ignore-unknown --no-error-on-unmatched-pattern --log-level warn --cache --cache-location \"node_modules/.cache/prettier/\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@carbon-labs/react-theme-settings": "^0.21.0",
    "@carbon-labs/utilities": "^0.21.0",
    "@carbon/ibm-products": "^2.74.0",
    "@carbon/react": "^1.102.0",
    "@ibm/plex": "^6.4.1",
    "classnames": "^2.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "react-router": "^7.5.2"
  },
  "devDependencies": {
    "@carbon-labs/vscode-snippets": "^0.2.0",
    "@double-great/stylelint-a11y": "^3.0.4",
    "@eslint/js": "^9.21.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.0.0",
    "jsdom": "^27.0.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.85.1",
    "stylelint": "^16.18.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-plugin-carbon-tokens": "^4.0.0",
    "stylelint-use-logical-spec": "^5.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0"
}
